# Copy to .env and fill in. .env is git-ignored.

# ---- Data backend selection ----
# postgres (default, for local dev/tests) or duckdb (deployed).
# DATA_BACKEND=postgres
# Local DuckDB file path when DATA_BACKEND=duckdb. This is the path baked into
# the image on Azure. On hosts without the file (Streamlit Community Cloud) the
# app downloads it from Azure Blob Storage into the writable Streamlit cache
# dir on first use (see AZURE_BLOB_* below); DUCKDB_PATH itself is not written.
# DUCKDB_PATH=data/trust_bandits.duckdb

# ---- Option A: single connection string (Postgres backend) ----
DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# ---- Option B: individual variables (used if DATABASE_URL is unset) ----
# AZURE_PG_HOST=your-server.postgres.database.azure.com
# AZURE_PG_PORT=5432
# AZURE_PG_DBNAME=trustbandits
# AZURE_PG_USER=your_admin_user
# AZURE_PG_PASSWORD=your_password
# AZURE_PG_SSLMODE=require

# ---- Azure Blob Storage (upload via export_duckdb.py; download on cold start) ----
# Set exactly one credential mode: either a connection string, or account URL +
# credential (account key or SAS token).
# AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=...
# AZURE_BLOB_ACCOUNT_URL=https://<account>.blob.core.windows.net
# AZURE_BLOB_CREDENTIAL=<account-key-or-sas>
# AZURE_BLOB_CONTAINER=trust-bandits
# AZURE_BLOB_NAME=dashboard/trust_bandits.duckdb

# Path to the raw simulation data (for ingest.py / export_duckdb.py)
# DATA_DIR=~/Dropbox/data_export/trust-bandits-analysis
